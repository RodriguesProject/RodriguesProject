Calendario =
ADDCOLUMNS (
    CALENDAR (
        MIN ( Vendas[data_pedido] ),
        MAX ( Vendas[data_pedido] )
    ),
    "Ano", YEAR ( [Date] ),
    "MesNumero", MONTH ( [Date] ),
    "Mes", FORMAT ( [Date], "mmmm" ),
    "AnoMes", FORMAT ( [Date], "yyyy-MM" ),
    "Trimestre", "T" & FORMAT ( [Date], "Q" )
)

-- Ordenação:
-- Selecione Calendario[Mes] e use Classificar por coluna > MesNumero.
-- Relacione Calendario[Date] (1) com Vendas[data_pedido] (*).
